# Full site address, used for hreflang, canonical and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://granska.example.com

# Supabase project address and publishable key, for sign-in and check counts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Name announced to mail servers. Must match the server IP's reverse DNS in production.
HELO_HOST=granska.example.com

# Envelope sender used in the mailbox check. No mail is ever sent from it.
MAIL_FROM=verify@granska.example.com

# Cap per mail server, in milliseconds.
SMTP_TIMEOUT_MS=8000

# Set to 1 where outgoing port 25 is blocked. Mailbox results become Unknown.
# Vercel always counts as blocked.
SKIP_MAILBOX=0
