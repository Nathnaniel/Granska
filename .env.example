# Load with: node --env-file=.env server.js
PORT=3000

# Set to 127.0.0.1 behind a reverse proxy, so nobody can bypass it.
HOST=

# Name announced to mail servers. Must match the server IP's reverse DNS in production.
HELO_HOST=granska.example.com

# Envelope sender used in the mailbox check. No mail is ever sent from it.
MAIL_FROM=verify@granska.example.com

# Set to 1 only behind a reverse proxy you control, so X-Forwarded-For is trusted.
TRUST_PROXY=0

# Cap per mail server, in milliseconds.
SMTP_TIMEOUT_MS=8000

# Set to 1 on hosts that block outgoing port 25. Mailbox results become Unknown.
SKIP_MAILBOX=0
