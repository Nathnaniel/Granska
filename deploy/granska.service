[Unit]
Description=Granska
After=network-online.target
Wants=network-online.target

[Service]
User=granska
WorkingDirectory=/opt/granska
EnvironmentFile=/etc/granska.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
